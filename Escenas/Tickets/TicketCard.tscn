[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/TicketCard.gd" id="1"]

[node name="TicketCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="HeaderButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
flat = true

[node name="HeaderRow" type="HBoxContainer" parent="Margin/VBox/HeaderButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="ClientIcon" type="TextureRect" parent="Margin/VBox/HeaderButton/HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Margin/VBox/HeaderButton/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
vertical_alignment = 1
text = "Título del ticket"

[node name="DecisionTimeLabel" type="Label" parent="Margin/VBox/HeaderButton/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
vertical_alignment = 1
text = "00:00"

[node name="ExpandedContent" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="DescriptionLabel" type="Label" parent="Margin/VBox/ExpandedContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Descripción del ticket..."

[node name="RequirementsLabel" type="Label" parent="Margin/VBox/ExpandedContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Requiere: 0.0 TF / 0 Mbps / 0 MB"

[node name="ProcessTimeLabel" type="Label" parent="Margin/VBox/ExpandedContent"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Procesando: 00:00"

[node name="ButtonsRow" type="HBoxContainer" parent="Margin/VBox/ExpandedContent"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RejectButton" type="Button" parent="Margin/VBox/ExpandedContent/ButtonsRow"]
unique_name_in_owner = true
layout_mode = 2
text = "RECHAZAR"

[node name="AcceptButton" type="Button" parent="Margin/VBox/ExpandedContent/ButtonsRow"]
unique_name_in_owner = true
layout_mode = 2
text = "ACEPTAR"

[node name="DecisionTimer" type="Timer" parent="."]
one_shot = true

[node name="ProcessTimer" type="Timer" parent="."]
one_shot = true

[node name="ResolveRequest" type="HTTPRequest" parent="."]
